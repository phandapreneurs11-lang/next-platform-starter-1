  <!-- SCRIPT: All logic (indicators, fetchers, signal engine) -->
  <script>
  // -------------------------
  // Utility helpers
  // -------------------------
  function nowTime(){ return new Date().toLocaleString(); }
  function fmt(n){ if(n===null||n===undefined) return '—'; return parseFloat(n).toLocaleString(undefined,{maximumFractionDigits:5}); }

  // Sound alert (buy/sell)
  function playTone(type){
    try{
      const ctx = new (window.AudioContext||window.webkitAudioContext)();
      const o = ctx.createOscillator();
      const g = ctx.createGain();
      o.type = 'sine';
      o.frequency.value = type === 'buy' ? 880 : 220;
      o.connect(g); g.connect(ctx.destination);
      o.start(); g.gain.setValueAtTime(0.2, ctx.currentTime);
      g.gain.exponentialRampToValueAtTime(0.00001, ctx.currentTime + 0.6);
      setTimeout(()=>o.stop(), 700);
    }catch(e){ /* ignore */ }
  }

  // -------------------------
  // Market data fetcher
  // -------------------------
  async function fetchKlines(symbol, interval='15m', limit=200){
    // Convert timeframe to Binance interval if needed
    const tfMap = {'1m':'1m','5m':'5m','15m':'15m','1h':'1h','4h':'4h','1d':'1d'};
    const bInterval = tfMap[interval] || '15m';
    const upper = symbol.toUpperCase();

    // If it's a Binance-style symbol
    if(upper.endsWith('USD') && upper !== 'BTCUSD'){
      const url = `https://api.binance.com/api/v3/klines?symbol=${upper}&interval=${bInterval}&limit=${limit}`;
      try {
        const r = await fetch(url);
        if(!r.ok) throw new Error('binance error');
        const data = await r.json();
        return data.map(d=>({t:d[0],open:+d[1],high:+d[2],low:+d[3],close:+d[4],vol:+d[5]}));
      } catch(e){ console.warn('Binance fetch failed',e); }
    }

    // For other symbols, simulate data
    return simulateCandles(upper, limit);
  }

  // quick candle simulator as fallback
  function simulateCandles(symbol, count=200){
    let base = 1.10;
    if(symbol.includes('BTC')) base = 95500;
    if(symbol.includes('ETH')) base = 3200;
    if(symbol.includes('XAU')||symbol.includes('GOLD')) base = 1950;
    if(symbol.includes('EUR')) base = 1.09;
    if(symbol.includes('JPY')) base = 150;
    const out = [];
    let price = base;
    for(let i=0;i<count;i++){
      const change = (Math.random()-0.5) * base * 0.002;
      const open = price;
      const close = Math.max(0.00001, open + change);
      const high = Math.max(open,close) + Math.abs(change)*0.5;
      const low  = Math.min(open,close) - Math.abs(change)*0.5;
      out.push({t: Date.now() - (count-i)*60000, open, high, low, close, vol: Math.random()*1000});
      price = close;
    }
    return out;
  }

  // -------------------------
  // Indicators: EMA, SMA, RSI, ATR
  // -------------------------
  function sma(values, period){
    if(values.length < period) return null;
    let sum = 0;
    for(let i=values.length-period;i<values.length;i++) sum += values[i];
    return sum/period;
  }
  function ema(values, period){
    if(values.length === 0) return null;
    const k = 2/(period+1);
    let emaPrev = values[0];
    for(let i=1;i<values.length;i++){
      emaPrev = values[i]*k + emaPrev*(1-k);
    }
    return emaPrev;
  }
  function rsi(values, period=14){
    if(values.length < period+1) return null;
    let gains = 0, losses = 0;
    for(let i=values.length-period;i<values.length;i++){
      const change = values[i] - values[i-1];
      if(change>0) gains += change; else losses += Math.abs(change);
    }
    const avgGain = gains/period, avgLoss = losses/period;
    if(avgLoss === 0) return 100;
    const rs = avgGain/avgLoss;
    return 100 - (100/(1+rs));
  }
  function atr(candles, period=14){
    if(candles.length < period+1) return null;
    const trs = [];
    for(let i=candles.length-period;i<candles.length;i++){
      const cur = candles[i];
      const prev = candles[i-1];
      const tr = Math.max(cur.high - cur.low, Math.abs(cur.high - prev.close), Math.abs(cur.low - prev.close));
      trs.push(tr);
    }
    return sma(trs, trs.length);
  }

  // -------------------------
  // Market Structure Detection (ICT/SMC concepts)
  // -------------------------
  function detectMarketStructure(candles){
    if(candles.length < 20) return {type:'Unknown'};
    
    // Find swing highs and lows
    const highs = candles.map(c => c.high);
    const lows = candles.map(c => c.low);
    
    // Simple detection: check if we have HH/HL or LH/LL
    const recentHighs = highs.slice(-8);
    const recentLows = lows.slice(-8);
    
    const maxHigh = Math.max(...recentHighs);
    const minLow = Math.min(...recentLows);
    
    // Determine structure
    if (recentHighs[recentHighs.length-1] === maxHigh && recentLows[recentLows.length-1] > recentLows[recentLows.length-3]) {
      return {type: 'Bullish Structure (HH/HL)', bos: true};
    } else if (recentLows[recentLows.length-1] === minLow && recentHighs[recentHighs.length-1] < recentHighs[recentHighs.length-3]) {
      return {type: 'Bearish Structure (LH/LL)', bos: true};
    } else {
      return {type: 'Ranging / Consolidation', bos: false};
    }
  }

  // -------------------------
  // Fair Value Gap detection
  // -------------------------
  function detectFVG(candles){
    // Check last 10 candles for FVGs
    for(let i = candles.length-1; i > 5; i--){
      const c1 = candles[i-2];   // First candle
      const c2 = candles[i-1];   // FVG candle
      const c3 = candles[i];     // Third candle
      
      // Bullish FVG: c2 low > c1 high and c3 doesn't fill the gap
      if(c2.low > c1.high && c3.low > c1.high){
        return {side: 'bullish', gapLow: c1.high, gapHigh: c2.low};
      }
      
      // Bearish FVG: c2 high < c1 low and c3 doesn't fill the gap
      if(c2.high < c1.low && c3.high < c1.low){
        return {side: 'bearish', gapHigh: c1.low, gapLow: c2.high};
      }
    }
    return null;
  }

  // -------------------------
  // Liquidity detection
  // -------------------------
  function detectLiquidity(candles){
    const recent = candles.slice(-30);
    const highs = recent.map(c => c.high);
    const lows = recent.map(c => c.low);
    
    // Find equal highs and lows (liquidity pools)
    const highCounts = {};
    const lowCounts = {};
    
    highs.forEach(h => {
      const rounded = Math.round(h * 100) / 100;
      highCounts[rounded] = (highCounts[rounded] || 0) + 1;
    });
    
    lows.forEach(l => {
      const rounded = Math.round(l * 100) / 100;
      lowCounts[rounded] = (lowCounts[rounded] || 0) + 1;
    });
    
    const highLiquidity = Object.entries(highCounts)
      .filter(([_, count]) => count >= 2)
      .map(([price]) => parseFloat(price));
      
    const lowLiquidity = Object.entries(lowCounts)
      .filter(([_, count]) => count >= 2)
      .map(([price]) => parseFloat(price));
    
    return {highLiquidity, lowLiquidity};
  }

  // -------------------------
  // Signal engine
  // -------------------------
  async function analyzeSignal(){
    const symbol = document.getElementById('symbol').value;
    const tf = document.getElementById('tf').value;
    const strategy = document.getElementById('strategy').value;
    const useRSI = document.getElementById('useRSI').checked;
    const useATR = document.getElementById('useATR').checked;
    const detectMSflag = document.getElementById('detectMS').checked;

    const candles = await fetchKlines(symbol, tf, 100);
    if(!candles || candles.length<10) {
      alert('Not enough candle data for ' + symbol);
      return null;
    }
    const closes = candles.map(c=>c.close);

    // Compute indicators
    const emaFastVal = ema(closes, 12);
    const emaSlowVal = ema(closes, 26);
    const rsiVal = useRSI ? rsi(closes, 14) : null;
    const atrVal = useATR ? atr(candles, 14) : null;

    // Determine signal side
    let side = 'NEUTRAL';
    if(emaFastVal && emaSlowVal){
      side = emaFastVal > emaSlowVal ? 'BUY' : 'SELL';
    }

    // Market structure analysis
    const ms = detectMSflag ? detectMarketStructure(candles) : {type:'N/A'};
    const fvg = detectFVG(candles);
    const liq = detectLiquidity(candles);

    // Confidence calculation
    let confidence = 50;
    if(ms.bos) confidence += 20;
    if(fvg) confidence += 15;
    if(rsiVal && ((side==='BUY' && rsiVal < 40) || (side==='SELL' && rsiVal > 60))) confidence += 10;

    // Entry and TP/SL levels
    const entryPrice = closes[closes.length-1];
    let tp, sl;
    
    if(useATR && atrVal){
      const tpMult = 1.8, slMult = 1.2;
      if(side==='BUY'){ 
        tp = entryPrice + atrVal * tpMult; 
        sl = Math.max(0.00001, entryPrice - atrVal * slMult); 
      } else if(side==='SELL'){ 
        tp = entryPrice - atrVal * tpMult; 
        sl = entryPrice + atrVal * slMult; 
      } else { 
        tp = entryPrice * 1.005; 
        sl = entryPrice * 0.995; 
      }
    } else {
      // Percent-based fallback
      const tpPerc = 0.008, slPerc = 0.005;
      if(side==='BUY'){ 
        tp = entryPrice * (1+tpPerc); 
        sl = entryPrice * (1-slPerc); 
      } else if(side==='SELL'){ 
        tp = entryPrice * (1-tpPerc); 
        sl = entryPrice * (1+slPerc); 
      } else { 
        tp = entryPrice * (1+tpPerc); 
        sl = entryPrice * (1-tpPerc); 
      }
    }

    // Reason string
    const reasonParts = [];
    reasonParts.push(`${strategy.toUpperCase()} strategy`);
    if(ms.type) reasonParts.push(ms.type);
    if(fvg) reasonParts.push(`${fvg.side} FVG`);
    if(rsiVal) reasonParts.push(`RSI:${rsiVal.toFixed(1)}`);

    return {
      symbol, tf, side, entryPrice, tp, sl, confidence, 
      reason: reasonParts.join(' • '),
      emaFastVal, emaSlowVal, rsiVal, atrVal, ms, fvg, liq, candles
    };
  }

