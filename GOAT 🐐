  // -------------------------
  // TradingView embed
  // -------------------------
  let tvWidget = null;
  function createTradingView(symbol, tf){
    try { if(tvWidget) tvWidget.remove(); } catch(e){}
    
    const tvSym = (() => {
      const s = symbol.toUpperCase();
      if(s.endsWith('USD') && !s.includes('BTC')) return 'BINANCE:' + s;
      if(s.includes('BTC')) return 'BINANCE:BTCUSDT';
      const fxList = ['EURUSD','GBPUSD','USDJPY','USDCAD','AUDUSD','NZDUSD','XAUUSD','XAGUSD'];
      if(fxList.includes(s)) return 'OANDA:' + s;
      const map = { 'NAS100':'NASDAQ:NDX','US30':'INDEX:DJI','US500':'INDEX:SPX','GER30':'INDEX:DEU40' };
      if(map[s]) return map[s];
      return symbol;
    })();

    const interval = tf.replace('m','');
    tvWidget = new TradingView.widget({
      autosize: true,
      symbol: tvSym,
      interval: interval,
      timezone: "Etc/UTC",
      theme: "dark",
      style: "1",
      locale: "en",
      container_id: "tv_chart_container",
      toolbar_bg: "#0b0f13",
      hide_top_toolbar: false,
      allow_symbol_change: true
    });
  }

  </script>
